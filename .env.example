# =============================================================================
# IndicatorsManagement — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#   cp .env.example .env
# =============================================================================

# --- Local SQL Server (docker-compose.dev.yml / docker-compose.yml) ----------
# Must satisfy SQL Server's password policy: 8+ chars, 3 of 4 character classes.
DB_SA_PASSWORD=Local_Dev_P@ssw0rd_2026

# --- Backend secrets (docker-compose.yml injects these into the api service) -
# Generate a fresh key per environment:  openssl rand -base64 48
JWT_SECRET_KEY=replace-me-with-a-random-key-of-at-least-32-characters

# Seeded on first run only (DatabaseSeeder). Change immediately after first login.
ADMIN_PASSWORD=Admin@123456

# --- SMTP (optional; email notifications are skipped when Host is empty) -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@indicators.local
SMTP_ENABLE_SSL=true

# --- MCP: mssql-server (.mcp.json reads these) ------------------------------
DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=Local_Dev_P@ssw0rd_2026
DB_DATABASE=IndicatorsManagement

# --- Frontend (frontend/.env.local) -----------------------------------------
# VITE_API_URL=http://localhost:5117
